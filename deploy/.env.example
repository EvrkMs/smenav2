# Образец. Скопировать в deploy/.env и заполнить; сам .env в репозиторий не попадает.

# ---- Локальная разработка (deploy/docker-compose.yml): всё необязательно ----
POSTGRES_DB=smena
POSTGRES_USER=smena
POSTGRES_PORT=5432

# ---- Развёртывание (deploy/docker-compose.prod.yml) ----
# Домен, который Caddy отдаёт наружу.
SMENA_DOMAIN=smena.example.com
# Пароль базы. Для локальной разработки по умолчанию smena_dev.
POSTGRES_PASSWORD=
# Пароль пользователя root панели при первом запуске (от 10 символов). Потом меняется в панели.
ROOT_PASSWORD=
# Токен первого устройства кассы (от 32 символов). Остальные выдаются в панели.
CASHIER_TOKEN=

# Необязательно.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URI=
MOYSKLAD_TOKEN=
