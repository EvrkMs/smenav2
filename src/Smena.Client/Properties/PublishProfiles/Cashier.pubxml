<?xml version="1.0" encoding="utf-8"?>
<!--
  Сборка программы для кассы: один Smena.Client.exe, которому не нужен
  установленный .NET. На кассе нужен только Microsoft Edge WebView2 Runtime
  (в Windows 10 и 11 он уже есть).

    dotnet publish src/Smena.Client -p:PublishProfile=Cashier

  Результат — artifacts/client/Smena.Client.exe.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WebView2Loader.dll и прочие родные библиотеки — внутри exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Отладочные символы внутри exe, документация пакетов не нужна: рядом не лежит ничего лишнего. -->
    <DebugType>embedded</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\client\</PublishDir>
  </PropertyGroup>
</Project>
